{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lanzador",
  "main": "src/api/index.ts",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "dist/web",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lanzador-db",
      "database_id": "dd532010-908e-4058-bc92-e3be2ca608f8",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "workflows": [
    { "name": "lanzador-job", "binding": "JOB_WF", "class_name": "JobWorkflow" }
  ],
  "ratelimits": [
    { "name": "RL_IP", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_USER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1003", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_EXP", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_UPL", "namespace_id": "1005", "simple": { "limit": 600, "period": 60 } },
    { "name": "RL_POLL", "namespace_id": "1006", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_CLIENT_ERR", "namespace_id": "1007", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    "APP_ORIGIN": "",
    "ENVIRONMENT": "production",
    "GRAPH_API_VERSION": "v24.0",
    "META_APP_ID": "",
    "META_LOGIN_CONFIG_ID": "",
    "TOKEN_ENC_KEY_CURRENT": 1,
    "GOOGLE_CLIENT_ID": "",
    "GOOGLE_PICKER_API_KEY": "",
    "GOOGLE_PROJECT_NUMBER": "",
    "EMAIL_FROM": "",
    "WORKERS_AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "WORKERS_AI_CHAT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
    "WORKERS_AI_DAILY_NEURON_CAP": 9000,
    "SUPERADMIN_EMAIL": ""
  },
  "env": {
    "preview": {
      "name": "lanzador-preview",
      "observability": { "enabled": true },
      "assets": {
        "directory": "dist/web",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lanzador-db-preview",
          "database_id": "4b238c86-26f6-41c3-978c-4b34a733aa4a",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "ratelimits": [
        { "name": "RL_IP", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_USER", "namespace_id": "2002", "simple": { "limit": 120, "period": 60 } },
        { "name": "RL_AUTH", "namespace_id": "2003", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_EXP", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_UPL", "namespace_id": "2005", "simple": { "limit": 600, "period": 60 } },
        { "name": "RL_POLL", "namespace_id": "2006", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_CLIENT_ERR", "namespace_id": "2007", "simple": { "limit": 20, "period": 60 } }
      ],
      "vars": {
        "APP_ORIGIN": "https://lanzador-preview.ilandaniele.workers.dev",
        "ENVIRONMENT": "preview",
        "GRAPH_API_VERSION": "v24.0",
        "META_APP_ID": "",
        "META_LOGIN_CONFIG_ID": "",
        "TOKEN_ENC_KEY_CURRENT": 1,
        "GOOGLE_CLIENT_ID": "",
        "GOOGLE_PICKER_API_KEY": "",
        "GOOGLE_PROJECT_NUMBER": "",
        "EMAIL_FROM": "",
        "WORKERS_AI_TEXT_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
        "WORKERS_AI_CHAT_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
        "WORKERS_AI_VISION_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
        "WORKERS_AI_DAILY_NEURON_CAP": 9000,
        "SUPERADMIN_EMAIL": ""
      }
    }
  }
}
